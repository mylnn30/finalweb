{% extends 'base.html.twig' %}
{% block title %}Change Password | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/profile.css') }}"><link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">{% endblock %}
{% block body %}
{% if is_granted('ROLE_ADMIN') %}{% include 'partials/admin_nav.html.twig' with {active: 'account'} %}
{% elseif is_granted('ROLE_STAFF') %}{% include 'partials/staff_nav.html.twig' with {active: 'account'} %}
{% else %}{% include 'partials/borrower_nav.html.twig' with {active: 'profile'} %}{% endif %}
<main class="profile-page"><section class="profile-container">
    <header class="profile-header"><h1>Change Password</h1><a class="profile-cancel-link" href="{{ path('app_account') }}">My Account</a></header>
    {{ form_start(form, {attr: {class: 'profile-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.current_password) }}
        {{ form_row(form.new_password.first) }}
        {{ form_row(form.new_password.second) }}
        {{ form_widget(form.save, {attr: {class: 'profile-edit-btn'}}) }}
    {{ form_end(form) }}
</section></main>
{% endblock %}
