{% extends 'base.html.twig' %}
{% block title %}Notifications | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">{% endblock %}
{% block body %}{% include 'partials/borrower_nav.html.twig' with {active: 'notifications', unreadCount: notifications|filter(n => not n.isRead)|length} %}<main class="dashboard-page"><section class="dashboard-welcome"><div><h1>Notifications</h1><p>Updates about your loan applications and payments.</p></div></section><section class="dashboard-card notification-card">{% if notifications is empty %}<p class="card-empty">You have no notifications.</p>{% else %}<ul class="activity-list">{% for notification in notifications %}<li><span>{{ notification.message }}<small>{{ notification.createdAt|date('M j, Y g:i A') }}</small></span>{% if not notification.isRead %}<form action="{{ path('app_notification_read', {id: notification.id}) }}" method="post" class="inline-form"><input type="hidden" name="_token" value="{{ csrf_token('notification_read_' ~ notification.id) }}"><button type="submit" class="card-link">Mark as read</button></form>{% else %}<span class="cell-muted">Read</span>{% endif %}</li>{% endfor %}</ul>{% endif %}</section></main>{% endblock %}