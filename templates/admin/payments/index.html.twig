{% extends 'base.html.twig' %}
{% block title %}Payments | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}{% include 'partials/admin_nav.html.twig' with {active: 'payments'} %}<main class="admin-page"><header class="admin-header"><div><h1>Payments</h1><p>Record payments against a loan and review payment history.</p></div></header><h2 class="section-heading">Record a Payment</h2>{{ form_start(form, {attr: {class: 'admin-form', style: 'margin-bottom:28px'}}) }}{{ form_errors(form) }}<div class="form-row"><div class="form-group">{{ form_label(form.loan_id, 'Loan') }}{{ form_widget(form.loan_id) }}{{ form_errors(form.loan_id) }}</div><div class="form-group">{{ form_label(form.payment_date, 'Payment Date') }}{{ form_widget(form.payment_date) }}{{ form_errors(form.payment_date) }}</div></div><div class="form-row"><div class="form-group">{{ form_label(form.amount_paid, 'Amount Paid (₱)') }}{{ form_widget(form.amount_paid) }}{{ form_errors(form.amount_paid) }}</div><div class="form-group">{{ form_label(form.payment_method, 'Payment Method') }}{{ form_widget(form.payment_method) }}{{ form_errors(form.payment_method) }}</div></div><div class="form-row"><div class="form-group">{{ form_label(form.reference_number, 'Reference Number') }}{{ form_widget(form.reference_number) }}</div><div class="form-group">{{ form_label(form.status, 'Status') }}{{ form_widget(form.status) }}</div></div>{{ form_widget(form.record, {attr: {class: 'admin-btn admin-btn-approve'}}) }}{{ form_end(form) }}<h2 class="section-heading">{{ filter ? filter|title ~ ' Payments' : 'All Payments' }}</h2><nav class="report-tabs"><a href="{{ path('admin_payments') }}" class="report-tab">All</a>{% for state in ['pending','confirmed','failed'] %}<a href="{{ path('admin_payments', {status:state}) }}" class="report-tab {{ filter == state ? 'is-active' : '' }}">{{ state|title }}</a>{% endfor %}</nav><div class="admin-table-wrap">{% if payments is empty %}<div class="empty-state">No payments recorded yet.</div>{% else %}<table class="admin-table"><thead><tr><th>Borrower</th><th>Loan</th><th>Date</th><th>Amount</th><th>Method</th><th>Reference</th><th>Status</th><th></th></tr></thead><tbody>{% for payment in payments %}{% if not filter or payment.status == filter %}<tr><td>{{ payment.loanApplication.user.firstName }} {{ payment.loanApplication.user.lastName }}<div class="cell-muted">@{{ payment.loanApplication.user.username }}</div></td><td>#{{ payment.loanApplication.id }} — {{ payment.loanApplication.loanType|replace({'_':' '})|title }}</td><td>{{ payment.paymentDate|date('M j, Y') }}</td><td>₱{{ payment.amountPaid|number_format(2) }}</td><td>{{ payment.paymentMethod|replace({'_':' '})|title }}</td><td class="cell-muted">{{ payment.referenceNumber ?? '—' }}</td><td><span class="status-badge {{ payment.status == 'confirmed' ? 'status-approved' : (payment.status == 'failed' ? 'status-rejected' : 'status-pending') }}">{{ payment.status|title }}</span></td><td><div class="row-actions">{% if payment.status != 'confirmed' %}<form action="{{ path('admin_payment_status', {id:payment.id}) }}" method="post" class="inline-form"><input type="hidden" name="_token" value="{{ csrf_token('payment_status_' ~ payment.id) }}"><button class="admin-btn admin-btn-approve" name="status" value="confirmed">Confirm</button><button class="admin-btn admin-btn-reject" name="status" value="failed">Reject</button></form><form action="{{ path('admin_payment_delete', {id:payment.id}) }}" method="post" class="inline-form" onsubmit="return confirm('Delete this unconfirmed payment?')"><input type="hidden" name="_token" value="{{ csrf_token('payment_delete_' ~ payment.id) }}"><button class="admin-btn admin-btn-view" type="submit">Delete</button></form>{% else %}<span class="cell-muted">Locked</span>{% endif %}</div></td></tr>{% endif %}{% endfor %}</tbody></table>{% endif %}</div></main>{% endblock %}