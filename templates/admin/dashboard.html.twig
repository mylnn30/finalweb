{% extends 'base.html.twig' %}
{% block title %}Admin Dashboard | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}{% include 'partials/admin_nav.html.twig' with {active: 'overview'} %}<main class="admin-page"><header class="admin-header"><div><h1>Admin Dashboard</h1><p>System-wide users, staff, applications, and payment records.</p></div></header><section class="stat-row"><div class="stat-tile"><span class="stat-value">{{ totalUsers }}</span><span class="stat-label">Total Users</span></div><div class="stat-tile"><span class="stat-value">{{ staffCount }}</span><span class="stat-label">Total Staff</span></div><div class="stat-tile"><span class="stat-value">{{ totalRecords }}</span><span class="stat-label">Total Records (Applications + Payments)</span></div><div class="stat-tile"><span class="stat-value">{{ borrowers }}</span><span class="stat-label">Borrowers</span></div><div class="stat-tile"><span class="stat-value">{{ activeLoans }}</span><span class="stat-label">Active Loans</span></div><div class="stat-tile"><span class="stat-value">{{ pending }}</span><span class="stat-label">Pending Applications</span></div><div class="stat-tile"><span class="stat-value">{{ approved }}</span><span class="stat-label">Approved</span></div><div class="stat-tile"><span class="stat-value">{{ rejected }}</span><span class="stat-label">Rejected</span></div><div class="stat-tile"><span class="stat-value">{{ overdue }}</span><span class="stat-label">Overdue Loans</span></div><div class="stat-tile"><span class="stat-value">₱{{ collected|number_format(2) }}</span><span class="stat-label">Total Payments Collected</span></div></section></main>{% endblock %}