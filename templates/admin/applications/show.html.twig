{% extends 'base.html.twig' %}
{% block title %}Application #{{ application.id }} | Admin{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}{% include 'partials/admin_nav.html.twig' with {active: 'applications'} %}<main class="admin-page"><a href="{{ path('admin_applications') }}" class="back-link">← Back to All Applications</a><header class="admin-header"><div><h1>{{ application.loanType|replace({'_':' '})|title }}</h1><p>Submitted by {{ application.user.firstName }} {{ application.user.lastName }} (@{{ application.user.username }})</p></div><span class="status-badge status-{{ application.status }}">{{ application.status|title }}</span></header>
	<div class="detail-grid"><div class="detail-field"><span class="field-label">Applicant Email</span><span class="field-value">{{ application.user.email }}</span></div><div class="detail-field"><span class="field-label">Applicant Phone</span><span class="field-value">{{ application.user.phoneNumber }}</span></div><div class="detail-field detail-field-full"><span class="field-label">Applicant Address</span><span class="field-value">{{ application.user.address }}</span></div><div class="detail-field"><span class="field-label">Loan Amount</span><span class="field-value">₱{{ application.amount|number_format(2) }}</span></div><div class="detail-field"><span class="field-label">Repayment Term</span><span class="field-value">{{ application.termMonths }} Months</span></div><div class="detail-field"><span class="field-label">ID Type</span><span class="field-value">{{ application.idType|replace({'_':' '})|title }}</span></div><div class="detail-field"><span class="field-label">Employment Status</span><span class="field-value">{{ application.employmentStatus|replace({'_':' '})|title }}</span></div><div class="detail-field"><span class="field-label">Occupation / Job Title</span><span class="field-value">{{ application.occupation }}</span></div>{% if application.employmentStatus == 'employed' %}<div class="detail-field"><span class="field-label">Employer / Company Name</span><span class="field-value">{{ application.employerName }}</span></div><div class="detail-field"><span class="field-label">Length of Employment</span><span class="field-value">{{ application.lengthOfEmployment|replace({'_':' '})|title }}</span></div><div class="detail-field"><span class="field-label">Employer Contact Number</span><span class="field-value">{{ application.employerContactNumber }}</span></div>{% elseif application.employmentStatus == 'self_employed' %}<div class="detail-field"><span class="field-label">Business Name</span><span class="field-value">{{ application.businessName }}</span></div><div class="detail-field"><span class="field-label">Business Type</span><span class="field-value">{{ application.businessType|replace({'_':' '})|title }}</span></div>{% endif %}<div class="detail-field"><span class="field-label">Monthly Income</span><span class="field-value">₱{{ application.monthlyIncome|number_format(2) }}</span></div><div class="detail-field"><span class="field-label">Preferred Payment Frequency</span><span class="field-value">{{ application.paymentFrequency|title }}</span></div><div class="detail-field"><span class="field-label">Date Submitted</span><span class="field-value">{{ application.submittedAt|date('F j, Y g:i A') }}</span></div><div class="detail-field detail-field-full"><span class="field-label">Purpose</span><span class="field-value">{{ application.purpose|nl2br }}</span></div>
		<div class="detail-field"><span class="field-label">Valid ID</span><a href="{{ path('app_document', {filename: application.validIdPath}) }}" target="_blank" rel="noopener"><img src="{{ path('app_document', {filename: application.validIdPath}) }}" alt="Uploaded Valid ID" class="document-thumb"></a></div>
		<div class="detail-field"><span class="field-label">Proof of Income</span><a href="{{ path('app_document', {filename: application.proofOfIncomePath}) }}" target="_blank" rel="noopener"><img src="{{ path('app_document', {filename: application.proofOfIncomePath}) }}" alt="Uploaded Proof of Income" class="document-thumb"></a></div>
		<div class="detail-field"><span class="field-label">Proof of Address</span><a href="{{ path('app_document', {filename: application.proofOfAddressPath}) }}" target="_blank" rel="noopener"><img src="{{ path('app_document', {filename: application.proofOfAddressPath}) }}" alt="Uploaded Proof of Address" class="document-thumb"></a></div>
		{% if application.employmentCertificatePath %}<div class="detail-field"><span class="field-label">Employment Certificate</span><a href="{{ path('app_document', {filename: application.employmentCertificatePath}) }}" target="_blank" rel="noopener"><img src="{{ path('app_document', {filename: application.employmentCertificatePath}) }}" alt="Uploaded Employment Certificate" class="document-thumb"></a></div>{% endif %}
	</div>
	{% if application.status == 'approved' %}<section class="status-update-box" style="margin-bottom:24px"><h2>Loan Terms</h2><form action="{{ path('admin_application_terms', {id: application.id}) }}" method="post" class="admin-form"> <input type="hidden" name="_token" value="{{ csrf_token('application_terms_' ~ application.id) }}"><div class="form-row"><div class="form-group"><label for="interest_rate">Interest Rate (% per annum)</label><input id="interest_rate" type="number" name="interest_rate" step="0.01" min="0" value="{{ application.interestRate }}"></div><div class="form-group"><label for="next_due_date">Next Due Date</label><input id="next_due_date" type="date" name="next_due_date" value="{{ application.nextDueDate ? application.nextDueDate|date('Y-m-d') : '' }}"></div></div><button class="admin-btn admin-btn-approve" type="submit">Save Loan Terms</button></form></section><section class="status-update-box" style="margin-bottom:24px"><h2>Payments</h2><p>Remaining balance is calculated from confirmed payments.</p><a href="{{ path('admin_payments', {loan_id: application.id}) }}" class="admin-btn admin-btn-view">Record / View Payments</a></section>{% endif %}
	<section class="status-update-box"><h2>Update Status</h2><div class="row-actions">{% for state in ['pending','approved','rejected'] %}{% if application.status != state %}<form action="{{ path('admin_application_status', {id: application.id}) }}" method="post" class="inline-form"><input type="hidden" name="_token" value="{{ csrf_token('application_status_' ~ application.id) }}"><input type="hidden" name="status" value="{{ state }}"><button class="admin-btn admin-btn-{{ state == 'pending' ? 'pending' : (state == 'approved' ? 'approve' : 'reject') }}" type="submit">{{ state|title }}</button></form>{% endif %}{% endfor %}</div>{% if application.payments is empty %}<form method="post" action="{{ path('admin_application_delete', {id: application.id}) }}" onsubmit="return confirm('Delete this application?')"><input type="hidden" name="_token" value="{{ csrf_token('application_delete_' ~ application.id) }}"><button class="admin-btn admin-btn-reject" type="submit">Delete Application</button></form>{% else %}<p class="cell-muted">Applications with payment history cannot be deleted.</p>{% endif %}</section>
</main>{% endblock %}