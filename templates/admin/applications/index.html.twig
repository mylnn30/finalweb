{% extends 'base.html.twig' %}
{% block title %}Loan Applications | Admin{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}
{% include 'partials/admin_nav.html.twig' with {active: 'applications'} %}
<main class="admin-page">
    <header class="admin-header"><div><h1>Loan Applications</h1><p>Review and manage all borrower applications and staff assignments.</p></div></header>
    <form action="{{ path('admin_applications') }}" method="get" class="admin-search-bar">
        <input type="search" name="q" value="{{ query }}" placeholder="Search borrower username, name, or email">
        <select name="status"><option value="">All statuses</option>{% for value in ['pending','approved','rejected'] %}<option value="{{ value }}" {{ status == value ? 'selected' : '' }}>{{ value|title }}</option>{% endfor %}</select>
        <button class="admin-btn admin-btn-view" type="submit">Search</button>
    </form>
    <div class="admin-table-wrap">
        {% if applications is empty %}<div class="empty-state">No applications found.</div>
        {% else %}
            <table class="admin-table">
                <thead><tr><th>Applicant</th><th>Loan</th><th>Amount</th><th>Term</th><th>Assigned Staff</th><th>Submitted</th><th>Status</th><th></th></tr></thead>
                <tbody>{% for application in applications %}<tr>
                    <td>{{ application.user.firstName }} {{ application.user.lastName }}<div class="cell-muted">@{{ application.user.username }}</div></td>
                    <td>{{ application.loanType|replace({'_':' '})|title }}</td><td>₱{{ application.amount|number_format(2) }}</td><td>{{ application.termMonths }} mo</td>
                    <td>{{ application.assignedStaff ? application.assignedStaff.username : 'Unassigned' }}</td><td>{{ application.submittedAt|date('M j, Y') }}</td>
                    <td><span class="status-badge status-{{ application.status }}">{{ application.status|title }}</span></td>
                    <td><a class="admin-btn admin-btn-view" href="{{ path('admin_application_show', {id: application.id}) }}">View</a> <a class="admin-btn admin-btn-approve" href="{{ path('admin_application_edit', {id: application.id}) }}">Edit</a></td>
                </tr>{% endfor %}</tbody>
            </table>
        {% endif %}
    </div>
</main>
{% endblock %}
