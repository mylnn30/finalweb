{% extends 'base.html.twig' %}
{% block title %}Loan Applications | Admin{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}{% include 'partials/admin_nav.html.twig' with {active: 'applications'} %}<main class="admin-page"><header class="admin-header"><div><h1>Loan Applications</h1><p>Every application submitted across all users.</p></div></header><nav class="report-tabs"><a href="{{ path('admin_applications') }}" class="report-tab {{ not status ? 'is-active' : '' }}">All</a>{% for state in ['pending','approved','rejected'] %}<a href="{{ path('admin_applications', {status: state}) }}" class="report-tab {{ status == state ? 'is-active' : '' }}">{{ state|title }}</a>{% endfor %}</nav><div class="admin-table-wrap">{% if applications is empty %}<div class="empty-state">No loan applications have been submitted yet.</div>{% else %}<table class="admin-table"><thead><tr><th>Applicant</th><th>Loan Type</th><th>Amount</th><th>Term</th><th>Submitted</th><th>Status</th><th></th></tr></thead><tbody>{% for application in applications %}<tr><td>{{ application.user.firstName }} {{ application.user.lastName }}<div class="cell-muted">@{{ application.user.username }}</div></td><td>{{ application.loanType|replace({'_':' '})|title }}</td><td>₱{{ application.amount|number_format(2) }}</td><td>{{ application.termMonths }} mo</td><td class="cell-muted">{{ application.submittedAt|date('M j, Y') }}</td><td><span class="status-badge status-{{ application.status }}">{{ application.status|title }}</span></td><td><a href="{{ path('admin_application_show', {id: application.id}) }}" class="admin-btn admin-btn-view">View</a></td></tr>{% endfor %}</tbody></table>{% endif %}</div></main>{% endblock %}