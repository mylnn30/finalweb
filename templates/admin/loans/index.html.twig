{% extends 'base.html.twig' %}
{% block title %}Loans | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}{% include 'partials/admin_nav.html.twig' with {active: 'loans'} %}<main class="admin-page"><header class="admin-header"><div><h1>Loans</h1><p>Every approved loan currently active, with interest, term, and remaining balance.</p></div></header><nav class="report-tabs"><a href="{{ path('admin_loans') }}" class="report-tab {{ filter == 'all' ? 'is-active' : '' }}">All Active</a><a href="{{ path('admin_loans', {filter:'upcoming'}) }}" class="report-tab {{ filter == 'upcoming' ? 'is-active' : '' }}">Due in 7 Days</a><a href="{{ path('admin_loans', {filter:'overdue'}) }}" class="report-tab {{ filter == 'overdue' ? 'is-active' : '' }}">Overdue</a></nav><div class="admin-table-wrap">{% if loans is empty %}<div class="empty-state">No loans match this filter.</div>{% else %}<table class="admin-table"><thead><tr><th>Borrower</th><th>Loan Type</th><th>Amount</th><th>Interest</th><th>Term</th><th>Remaining Balance</th><th>Installment</th><th>Next Due</th><th></th></tr></thead><tbody>{% for row in loans %}{% set loan = row.loan %}<tr><td>{{ loan.user.firstName }} {{ loan.user.lastName }}<div class="cell-muted">@{{ loan.user.username }}</div></td><td>{{ loan.loanType|replace({'_':' '})|title }}</td><td>₱{{ loan.amount|number_format(2) }}</td><td class="cell-muted">{{ loan.interestRate is not null ? loan.interestRate|number_format(2) ~ '%' : 'Not set' }}</td><td>{{ loan.termMonths }} mo</td><td>₱{{ row.balance|number_format(2) }}</td><td>₱{{ row.installment|number_format(2) }} / {{ loan.paymentFrequency }}</td><td><span class="status-badge {{ row.overdue ? 'status-rejected' : 'status-pending' }}">{{ loan.nextDueDate ? loan.nextDueDate|date('M j, Y') : 'Not set' }}</span></td><td><div class="row-actions"><a href="{{ path('admin_application_show', {id: loan.id}) }}" class="admin-btn admin-btn-view">View</a><form method="post" action="{{ path('admin_loan_action', {id: loan.id, filter: filter}) }}" class="inline-form"><input type="hidden" name="_token" value="{{ csrf_token('loan_action_' ~ loan.id) }}"><button class="admin-btn admin-btn-pending" name="action" value="{{ row.overdue ? 'notify_overdue' : 'remind' }}">{{ row.overdue ? 'Notify Overdue' : 'Send Reminder' }}</button>{% if row.overdue %}<button class="admin-btn admin-btn-reject" name="action" value="apply_penalty" onclick="return confirm('Apply the configured late fee?')">Apply Late Fee</button>{% endif %}</form></div></td></tr>{% endfor %}</tbody></table>{% endif %}</div></main>{% endblock %}