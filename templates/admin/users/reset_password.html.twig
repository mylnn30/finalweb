{% extends 'base.html.twig' %}
{% block title %}Reset Password | Admin{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}
{% include 'partials/admin_nav.html.twig' with {active: 'borrowers'} %}
<main class="admin-page">
    <a class="back-link" href="{{ path('admin_user_show', {id: managedUser.id}) }}">← Back to account</a>
    <header class="admin-header"><div><h1>Reset Password</h1><p>Set a new password for @{{ managedUser.username }}.</p></div></header>
    {{ form_start(form, {attr: {class: 'admin-form'}}) }}
        {{ form_errors(form) }}
        {{ form_row(form.password.first) }}
        {{ form_row(form.password.second) }}
        {{ form_widget(form.reset, {attr: {class: 'admin-btn admin-btn-approve'}}) }}
    {{ form_end(form) }}
</main>
{% endblock %}
