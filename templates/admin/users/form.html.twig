{% extends 'base.html.twig' %}
{% block title %}Add User | Admin{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}
    {% include 'partials/admin_nav.html.twig' with {active: 'borrowers'} %}
    <main class="admin-page">
        <a href="{{ path('admin_users') }}" class="back-link">← Back to Users</a>
        <header class="admin-header">
            <div>
                <h1>Add New Account</h1>
                <p>Create a borrower, staff, or administrator account.</p>
            </div>
        </header>
        {{ form_start(form, {attr: {class: 'admin-form'}}) }}
        {{ form_errors(form) }}
        <div class="form-row">
            <div class="form-group">{{ form_label(form.username, 'Username') }}{{ form_widget(form.username) }}{{ form_errors(form.username) }}</div>
            <div class="form-group">{{ form_label(form.email, 'Email') }}{{ form_widget(form.email) }}{{ form_errors(form.email) }}</div>
        </div>
        <div class="form-row">
            <div class="form-group">{{ form_label(form.first_name, 'First Name') }}{{ form_widget(form.first_name) }}{{ form_errors(form.first_name) }}</div>
            <div class="form-group">{{ form_label(form.middle_name, 'Middle Name') }}{{ form_widget(form.middle_name) }}{{ form_errors(form.middle_name) }}</div>
        </div>
        <div class="form-row">
            <div class="form-group">{{ form_label(form.last_name, 'Last Name') }}{{ form_widget(form.last_name) }}{{ form_errors(form.last_name) }}</div>
            <div class="form-group">{{ form_label(form.phone_number, 'Phone Number') }}{{ form_widget(form.phone_number) }}{{ form_errors(form.phone_number) }}</div>
        </div>
        <div class="form-group">{{ form_label(form.address, 'Address') }}{{ form_widget(form.address, {attr: {rows: 2}}) }}{{ form_errors(form.address) }}</div>
        <div class="form-group">{{ form_row(form.role) }}</div>
        <div class="form-row">
            <div class="form-group">{{ form_label(form.password.first, 'Password') }}{{ form_widget(form.password.first) }}{{ form_errors(form.password.first) }}</div>
            <div class="form-group">{{ form_label(form.password.second, 'Confirm Password') }}{{ form_widget(form.password.second) }}{{ form_errors(form.password.second) }}</div>
        </div>
        {{ form_widget(form.save, {attr: {class: 'admin-btn admin-btn-approve'}}) }}
        {{ form_end(form) }}
    </main>
{% endblock %}
