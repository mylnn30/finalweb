{% extends 'base.html.twig' %}
{% block title %}Users | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}
    {% include 'partials/admin_nav.html.twig' with {active: 'borrowers'} %}
    <main class="admin-page">
        <header class="admin-header">
            <div>
                <h1>Users</h1>
                <p>Borrower, staff, and administrator accounts.</p>
            </div>
            <a href="{{ path('admin_user_new') }}" class="admin-btn admin-btn-approve">+ Add User</a>
        </header>
        <form action="{{ path('admin_users') }}" method="get" class="admin-search-bar">
            <input type="search" name="q" placeholder="Search username, name, or email" value="{{ query }}">
            <select name="role">
                <option value="">All roles</option>
                {% for value, label in {'borrower':'Borrower','staff':'Staff','admin':'Admin'} %}
                    <option value="{{ value }}" {{ role == value ? 'selected' : '' }}>{{ label }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="admin-btn admin-btn-view">Search</button>
        </form>
        <div class="admin-table-wrap">
            {% if users is empty %}
                <div class="empty-state">No users found.</div>
            {% else %}
                <table class="admin-table">
                    <thead>
                        <tr><th>Username</th><th>Name</th><th>Email</th><th>Role</th><th>Created</th><th>Status</th><th>Account controls</th></tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td><a href="{{ path('admin_user_show', {id:user.id}) }}">{{ user.username }}</a></td>
                                <td>{{ user.firstName }} {{ user.lastName }}</td>
                                <td class="cell-muted">{{ user.email }}</td>
                                <td><span class="role-badge {{ user.isAdmin ? 'is-admin' : '' }}">{{ user.isAdmin ? 'Admin' : (user.isStaff ? 'Staff' : 'Borrower') }}</span></td>
                                <td>{{ user.createdAt|date('M j, Y') }}</td>
                                <td><span class="status-badge {{ user.isActive ? 'status-approved' : 'status-rejected' }}">{{ user.isActive ? 'Active' : 'Disabled' }}</span></td>
                                <td>
                                    <div class="row-actions">
                                        <a href="{{ path('admin_user_show', {id:user.id}) }}" class="admin-btn admin-btn-view">View</a>
                                        {% if user.id != app.user.id %}
                                            {% for targetRole in ['borrower','staff','admin'] %}
                                                {% if targetRole != (user.isAdmin ? 'admin' : (user.isStaff ? 'staff' : 'borrower')) %}
                                                    <form action="{{ path('admin_user_access', {id:user.id}) }}" method="post" class="inline-form">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('user_access_' ~ user.id) }}">
                                                        <button class="admin-btn admin-btn-view" name="action" value="{{ targetRole }}">Make {{ targetRole|title }}</button>
                                                    </form>
                                                {% endif %}
                                            {% endfor %}
                                            <form action="{{ path('admin_user_access', {id:user.id}) }}" method="post" class="inline-form">
                                                <input type="hidden" name="_token" value="{{ csrf_token('user_access_' ~ user.id) }}">
                                                <button class="admin-btn {{ user.isActive ? 'admin-btn-reject' : 'admin-btn-approve' }}" name="action" value="{{ user.isActive ? 'deactivate' : 'activate' }}">{{ user.isActive ? 'Disable' : 'Enable' }}</button>
                                            </form>
                                        {% else %}
                                            <span class="cell-muted">You</span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </main>
{% endblock %}
