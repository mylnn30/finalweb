{% extends 'base.html.twig' %}
{% block title %}User {{ managedUser.username }} | Admin{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}{% include 'partials/admin_nav.html.twig' with {active: 'borrowers'} %}<main class="admin-page"><a href="{{ path('admin_users') }}" class="back-link">← Back to Users</a><header class="admin-header"><div><h1>{{ managedUser.firstName }} {{ managedUser.lastName }}</h1><p>Account details and activity.</p></div><a href="{{ path('admin_user_edit', {id:managedUser.id}) }}" class="admin-btn admin-btn-view">Edit</a></header><div class="detail-grid"><div class="detail-field"><span class="field-label">Username</span><span class="field-value">{{ managedUser.username }}</span></div><div class="detail-field"><span class="field-label">Email</span><span class="field-value">{{ managedUser.email }}</span></div><div class="detail-field"><span class="field-label">Phone</span><span class="field-value">{{ managedUser.phoneNumber }}</span></div><div class="detail-field"><span class="field-label">Role</span><span class="field-value">{{ managedUser.isAdmin ? 'Admin' : 'Borrower' }}</span></div><div class="detail-field"><span class="field-label">Status</span><span class="field-value">{{ managedUser.isActive ? 'Active' : 'Deactivated' }}</span></div></div>{% if managedUser.id != app.user.id and managedUser.loanApplications is empty and managedUser.notifications is empty %}<form method="post" action="{{ path('admin_user_delete', {id:managedUser.id}) }}" onsubmit="return confirm('Delete this account?')"><input type="hidden" name="_token" value="{{ csrf_token('user_delete_' ~ managedUser.id) }}"><button class="admin-btn admin-btn-reject" type="submit">Delete user</button></form>{% else %}<p class="cell-muted">Account deletion is unavailable for the current user or accounts with history.</p>{% endif %}</main>{% endblock %}