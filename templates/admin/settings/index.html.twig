{% extends 'base.html.twig' %}
{% block title %}System Settings | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}{% include 'partials/admin_nav.html.twig' with {active: 'settings'} %}<main class="admin-page"><header class="admin-header"><div><h1>System Settings</h1><p>Defaults used across the loan system. Individual loans can be set differently.</p></div></header>{{ form_start(form, {attr: {class: 'admin-form'}}) }}{{ form_errors(form) }}<div class="form-group">{{ form_label(form.default_interest_rate, 'Default Interest Rate (% per annum)') }}{{ form_widget(form.default_interest_rate, {attr: {min: 0, step: '0.01'}}) }}{{ form_errors(form.default_interest_rate) }}</div><div class="form-group">{{ form_label(form.late_payment_penalty_percent, 'Late Payment Penalty (%)') }}{{ form_widget(form.late_payment_penalty_percent, {attr: {min: 0, step: '0.01'}}) }}{{ form_errors(form.late_payment_penalty_percent) }}</div><div class="form-group">{{ form_label(form.grace_period_days, 'Grace Period (days after due date before marked overdue)') }}{{ form_widget(form.grace_period_days, {attr: {min: 0, step: 1}}) }}{{ form_errors(form.grace_period_days) }}</div>{{ form_widget(form.save, {attr: {class: 'admin-btn admin-btn-approve'}}) }}{{ form_end(form) }}</main>{% endblock %}