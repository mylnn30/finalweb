{% extends 'base.html.twig' %}
{% block title %}Reports | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}{% include 'partials/admin_nav.html.twig' with {active: 'reports'} %}<main class="admin-page"><header class="admin-header"><div><h1>Reports</h1><p>Pull a report by type and export it as a CSV.</p></div>{% if type != 'summary' %}<a href="{{ path('admin_report_export', {type:type}) }}" class="admin-btn admin-btn-view">Export CSV</a>{% endif %}</header><nav class="report-tabs">{% for report in ['loans','payments','borrowers','overdue','summary'] %}<a href="{{ path('admin_reports', {type:report}) }}" class="report-tab {{ type == report ? 'is-active' : '' }}">{{ report|replace({'_':' '})|title }}</a>{% endfor %}</nav>
	{% if type == 'summary' %}<form action="{{ path('admin_reports') }}" method="get" class="admin-search-bar"><input type="hidden" name="type" value="summary"><select name="month" class="admin-btn admin-btn-view">{% for m in 1..12 %}<option value="{{ m }}" {{ m == month ? 'selected' : '' }}>{{ date('F', date('2000-' ~ '%02d'|format(m) ~ '-01')) }}</option>{% endfor %}</select><select name="year" class="admin-btn admin-btn-view">{% for y in range('now'|date('Y'), 'now'|date('Y') - 4) %}<option value="{{ y }}" {{ y == year ? 'selected' : '' }}>{{ y }}</option>{% endfor %}</select><button class="admin-btn admin-btn-approve" type="submit">View</button></form><section class="stat-row"><div class="stat-tile"><span class="stat-value">₱{{ summary.approvedAmount|number_format(2) }}</span><span class="stat-label">Disbursed (Approved Loans)</span></div><div class="stat-tile"><span class="stat-value">₱{{ summary.collected|number_format(2) }}</span><span class="stat-label">Collected (Confirmed Payments)</span></div><div class="stat-tile"><span class="stat-value">{{ summary.newApplications }}</span><span class="stat-label">New Applications</span></div></section>
	{% else %}<div class="admin-table-wrap"><table class="admin-table"><thead>{% if type == 'borrowers' %}<tr><th>Username</th><th>Name</th><th>Email</th><th>Role</th><th>Status</th></tr>{% elseif type == 'payments' %}<tr><th>Borrower</th><th>Loan</th><th>Date</th><th>Amount</th><th>Method</th><th>Status</th></tr>{% else %}<tr><th>Borrower</th><th>Loan Type</th><th>Amount</th><th>Remaining Balance</th><th>Next Due</th><th>Status</th></tr>{% endif %}</thead><tbody>{% for row in rows %}<tr>{% if type == 'borrowers' %}<td>{{ row.username }}</td><td>{{ row.firstName }} {{ row.lastName }}</td><td class="cell-muted">{{ row.email }}</td><td><span class="role-badge {{ row.isAdmin ? 'is-admin' : '' }}">{{ row.isAdmin ? 'Admin' : 'Borrower' }}</span></td><td>{{ row.isActive ? 'Active' : 'Deactivated' }}</td>{% elseif type == 'payments' %}<td>{{ row.loanApplication.user.firstName }} {{ row.loanApplication.user.lastName }}</td><td>#{{ row.loanApplication.id }} — {{ row.loanApplication.loanType|replace({'_':' '})|title }}</td><td>{{ row.paymentDate|date('M j, Y') }}</td><td>₱{{ row.amountPaid|number_format(2) }}</td><td>{{ row.paymentMethod|replace({'_':' '})|title }}</td><td>{{ row.status|title }}</td>{% else %}<td>{{ row.user.firstName }} {{ row.user.lastName }}<div class="cell-muted">@{{ row.user.username }}</div></td><td>{{ row.loanType|replace({'_':' '})|title }}</td><td>₱{{ row.amount|number_format(2) }}</td><td>₱{{ finance.remainingBalance(row)|number_format(2) }}</td><td>{{ row.nextDueDate ? row.nextDueDate|date('M j, Y') : 'Not set' }}</td><td><span class="status-badge status-approved">Active</span></td>{% endif %}</tr>{% else %}<tr><td colspan="6" class="empty-state">No report rows.</td></tr>{% endfor %}</tbody></table></div>{% endif %}
</main>{% endblock %}