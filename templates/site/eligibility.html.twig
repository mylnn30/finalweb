{% extends 'base.html.twig' %}
{% block title %}Check Your Eligibility | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link rel="stylesheet" href="{{ asset('css/style.css') }}"><link rel="stylesheet" href="{{ asset('css/loan-application.css') }}"><link rel="stylesheet" href="{{ asset('css/check_eligibility.css') }}">{% endblock %}
{% block body %}
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header"><nav class="navbar navbar-expand-lg" aria-label="Primary navigation"><div class="container"><a class="brand" href="{{ path('app_home') }}" aria-label="Mletchido Financial Group home"><img src="{{ asset('assets/home_01.png') }}" alt="Mletchido Financial Group logo"></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="mainNavigation"><ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2"><li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#home">Home</a></li><li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#services">Business Loans</a></li><li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#calculator">Loan Calculator</a></li><li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#process">Process</a></li><li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#about">About Us</a></li><li class="nav-item"><a class="nav-link" href="{{ path('app_home') }}#faq">FAQ</a></li><li class="nav-item"><a class="nav-link active" href="{{ path('app_eligibility') }}">Check Eligibility</a></li><li class="nav-item ms-lg-2"><a class="btn btn-primary btn-sm px-4" href="{{ path('app_register') }}">Apply Now</a></li></ul></div></div></nav></header>
<main id="main-content">
    <section class="eligibility-hero"><div class="container"><p class="eyebrow">QUICK, NO-OBLIGATION CHECK</p><h1>Find Out If You Qualify — Before You Apply</h1><p>Answer a few quick questions and see instantly whether you meet our basic loan requirements. It won't affect your credit score.</p></div></section>
    {% if errors or result %}<div id="eligibility-status" tabindex="-1">{% if errors %}<section class="eligibility-alert-banner" role="alert"><div class="container"><p class="eligibility-alert">{{ errors|join(' ') }}</p></div></section>{% elseif result %}<section class="eligibility-notification eligibility-notification-{{ result.eligible ? 'pass' : 'fail' }}" aria-live="polite"><div class="container eligibility-notification-inner"><div class="eligibility-notification-icon" aria-hidden="true">{{ result.eligible ? '✓' : '!' }}</div><div class="eligibility-notification-body"><span class="eligibility-notification-label">{{ result.eligible ? 'You meet our basic requirements' : 'You do not meet all requirements yet' }}</span><p class="eligibility-notification-message">{{ result.eligible ? "You've met every requirement below. You're in a good position to apply." : 'Review the requirements below and check again when your details change.' }}</p><ul class="eligibility-checklist eligibility-checklist-compact">{% for check in result.checks %}<li class="eligibility-check-item {{ check.pass ? 'is-pass' : 'is-fail' }}"><span class="eligibility-check-icon" aria-hidden="true">{{ check.pass ? '✓' : '✕' }}</span><span>{{ check.label }}</span></li>{% endfor %}</ul></div><div class="eligibility-notification-side"><div class="eligibility-payment-estimate"><span>Estimated Monthly Payment</span><strong>₱{{ result.payment|number_format(2) }}/month</strong><small>Estimated at <b>4.99% APR</b></small></div><a href="{{ path('app_register') }}" class="btn {{ result.eligible ? 'btn-light' : 'btn-outline-light' }}">{{ result.eligible ? 'Apply Now' : 'Apply Anyway — Let Our Team Review' }}</a></div></div></section>{% endif %}</div>{% endif %}
    <section class="eligibility-section" aria-labelledby="eligibility-form-title"><div class="container eligibility-layout"><div class="eligibility-intro"><p class="card-eyebrow">WHY CHECK FIRST?</p><h2>Know Before You Apply</h2><p>A full loan application asks for documents and takes a few minutes. This quick check tells you where you stand first, so you're not caught off guard.</p><ul class="eligibility-benefits"><li><span class="eligibility-benefit-icon" aria-hidden="true">◷</span><span class="eligibility-benefit-text"><strong>Under a minute</strong><span class="eligibility-benefit-desc">Just five quick fields, no account needed.</span></span></li><li><span class="eligibility-benefit-icon" aria-hidden="true">◇</span><span class="eligibility-benefit-text"><strong>No credit impact</strong><span class="eligibility-benefit-desc">This is a self-check, not a credit inquiry.</span></span></li><li><span class="eligibility-benefit-icon" aria-hidden="true">✓</span><span class="eligibility-benefit-text"><strong>Clear requirements</strong><span class="eligibility-benefit-desc">See which requirements you meet.</span></span></li></ul><div class="eligibility-note">This tool checks basic requirements only (age, income source, minimum income, and loan amount). It is not a credit check and does not guarantee final approval.</div></div>
        <form class="eligibility-card loan-form" method="post" action="{{ path('app_eligibility') }}#eligibility-status" novalidate><header><p class="card-eyebrow">Check Your Eligibility</p><h3 id="eligibility-form-title">Tell us a bit about yourself</h3></header>
            <div class="eligibility-field"><label for="age">Age</label><input type="number" id="age" name="age" min="18" max="70" value="{{ data.age }}" required></div>
            <div class="eligibility-field"><label for="employment_status">Employment Status</label><select id="employment_status" name="employment_status" required><option value="">Select your status</option>{% for value, label in {'employed':'Employed','self_employed':'Self-Employed'} %}<option value="{{ value }}" {{ data.employment_status == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
            <div class="eligibility-field"><label for="monthly_income">Monthly Income (₱)</label><input type="number" id="monthly_income" name="monthly_income" min="0" step="0.01" value="{{ data.monthly_income }}" required></div>
            <div class="eligibility-field"><label for="loan_type">Loan Type</label><select id="loan_type" name="loan_type" required>{% for type, terms in loanTerms %}<option value="{{ type }}" data-terms="{{ terms|join(',') }}" {{ data.loan_type == type ? 'selected' : '' }}>{{ type|replace({'_':' '})|title }}</option>{% endfor %}</select></div>
            <div class="eligibility-field"><label for="amount">Loan Amount (₱)</label><input type="number" id="amount" name="amount" min="5000" max="50000000" step="1000" value="{{ data.amount }}" required></div>
            <div class="eligibility-field"><fieldset><legend>Repayment Term</legend><div class="eligibility-term-grid" id="termOptions"></div></fieldset></div>
            <button class="eligibility-submit" type="submit">Check My Eligibility</button><p class="eligibility-disclaimer">This is a quick self-check only, not a guarantee of approval or denial. Final terms are subject to verification, document review, and approval.</p>
        </form>
    </div></section>
</main>
<footer class="site-footer"><div class="container"><div class="footer-grid"><section><a class="brand footer-brand" href="{{ path('app_home') }}#home"><img src="{{ asset('assets/home_10.png') }}" alt="Mletchido Financial Group"></a><p>Providing trusted lending solutions that help individuals and businesses achieve their financial goals with confidence.</p></section><nav aria-label="Loan Services"><h2>Loan Services</h2><ul><li><a href="{{ path('app_home') }}#services">Personal Loans</a></li><li><a href="{{ path('app_home') }}#services">Home Loans</a></li><li><a href="{{ path('app_home') }}#services">Business Loans</a></li><li><a href="{{ path('app_home') }}#services">Asset Backed Loans</a></li></ul></nav><nav aria-label="Resources"><h2>Resources</h2><ul><li><a href="{{ path('app_home') }}#calculator">Loan Calculator</a></li><li><a href="{{ path('app_eligibility') }}">Check Eligibility</a></li><li><a href="{{ path('app_home') }}#faq">Frequently Asked Questions</a></li></ul></nav><nav aria-label="Company"><h2>Company</h2><ul><li><a href="{{ path('app_home') }}#about">About Us</a></li><li><a href="{{ path('app_home') }}#apply">Privacy Policy</a></li><li><a href="{{ path('app_home') }}#apply">Terms &amp; Conditions</a></li></ul></nav></div><div class="footer-bottom"><p>Mletchido Financial Group is committed to responsible, transparent lending. Applications are subject to verification, document review, and final approval.</p><p>© 2026 Mletchido Financial Group. All Rights Reserved.</p></div></div></footer>
{% endblock %}
{% block javascripts %}<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script>
document.addEventListener('DOMContentLoaded', () => {
    const loanTypeSelect = document.querySelector('#loan_type');
    const termOptions = document.querySelector('#termOptions');
    const postedTerm = {{ data.term|json_encode|raw }};
    function populateTerms() {
        const selected = loanTypeSelect?.options[loanTypeSelect.selectedIndex];
        const terms = (selected?.dataset.terms || '').split(',').filter(Boolean).map(Number);
        if (!termOptions) return;
        termOptions.innerHTML = '';
        terms.forEach((months) => {
            const label = document.createElement('label'); label.className = 'eligibility-term-chip';
            const input = document.createElement('input'); input.type = 'radio'; input.name = 'term'; input.value = months;
            input.checked = String(months) === String(postedTerm);
            const span = document.createElement('span'); span.textContent = months + ' mo';
            label.append(input, span); termOptions.append(label);
        });
        if (!termOptions.querySelector('input:checked') && termOptions.firstElementChild) termOptions.firstElementChild.querySelector('input').checked = true;
    }
    loanTypeSelect?.addEventListener('change', populateTerms); populateTerms();
    const status = document.querySelector('#eligibility-status');
    if (status && window.location.hash === '#eligibility-status') status.focus({preventScroll: false});
});
</script>{% endblock %}