{% extends 'base.html.twig' %}
{% block title %}Assigned Applications | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body %}
{% include 'partials/staff_nav.html.twig' with {active: 'applications'} %}
<main class="admin-page">
    <header class="admin-header"><div><h1>Assigned Applications</h1><p>You can manage only applications assigned to you.</p></div><a class="admin-btn admin-btn-approve" href="{{ path('staff_application_new') }}">+ Create Application</a></header>
    {% for message in app.flashes('success') %}<p role="status">{{ message }}</p>{% endfor %}
    {% for message in app.flashes('error') %}<p role="alert">{{ message }}</p>{% endfor %}
    <form action="{{ path('staff_applications') }}" method="get" class="admin-search-bar">
        <input type="search" name="q" value="{{ query }}" placeholder="Search borrower">
        <select name="status"><option value="">All statuses</option>{% for value in ['pending','approved','rejected'] %}<option value="{{ value }}" {{ status == value ? 'selected' : '' }}>{{ value|title }}</option>{% endfor %}</select>
        <button class="admin-btn admin-btn-view" type="submit">Search</button>
    </form>
    <div class="admin-table-wrap">
        {% if applications is empty %}<div class="empty-state">No assigned applications found.</div>
        {% else %}<table class="admin-table"><thead><tr><th>Borrower</th><th>Loan</th><th>Amount</th><th>Status</th><th>Submitted</th><th></th></tr></thead><tbody>
            {% for application in applications %}<tr>
                <td>{{ application.user.firstName }} {{ application.user.lastName }}<div class="cell-muted">@{{ application.user.username }}</div></td>
                <td>{{ application.loanType|replace({'_':' '})|title }}</td><td>₱{{ application.amount|number_format(2) }}</td>
                <td><span class="status-badge status-{{ application.status }}">{{ application.status|title }}</span></td><td>{{ application.submittedAt|date('M j, Y') }}</td>
                <td><a class="admin-btn admin-btn-view" href="{{ path('staff_application_show', {id: application.id}) }}">View</a> <a class="admin-btn admin-btn-approve" href="{{ path('staff_application_edit', {id: application.id}) }}">Edit</a></td>
            </tr>{% endfor %}
        </tbody></table>{% endif %}
    </div>
</main>
{% endblock %}
