{% extends 'base.html.twig' %}
{% block title %}Payments | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}"><link rel="stylesheet" href="{{ asset('css/payment.css') }}">{% endblock %}
{% block body %}{% include 'partials/borrower_nav.html.twig' with {active: 'payments'} %}<main class="dashboard-page"><section class="dashboard-welcome"><div><h1>Payments</h1><p>Submit a payment for an approved loan and track its status.</p></div></section>
	<section class="payment-section"><div class="payment-section-heading"><span class="payment-eyebrow">PAYMENT OPTIONS</span><h2>Where to Send Your Payment</h2><p>Choose your preferred payment method.</p></div><div class="payment-method-grid"><article class="payment-method-card"><div class="payment-method-top"><div class="payment-method-icon gcash-icon">G</div><div><h3>GCash</h3><span class="payment-method-subtitle">Mobile wallet</span></div></div><div class="payment-detail"><span>GCash Number</span><strong>0991 818 8995</strong></div><a href="{{ asset('assets/Gcash QR.jpg') }}" target="_blank" rel="noopener noreferrer" class="payment-qr-link"><img src="{{ asset('assets/Gcash QR.jpg') }}" alt="GCash QR Code" class="payment-qr"><span>View QR code</span></a></article><article class="payment-method-card"><div class="payment-method-top"><div class="payment-method-icon bank-icon">M</div><div><h3>MariBank</h3><span class="payment-method-subtitle">Bank transfer</span></div></div><div class="payment-detail"><span>Account Name</span><strong>MYLEN LETCHIDO</strong></div><div class="payment-detail"><span>Account</span><strong>MariBank (****1397)</strong></div><a href="{{ asset('assets/MariBank QR.jpg') }}" target="_blank" rel="noopener noreferrer" class="payment-qr-link"><img src="{{ asset('assets/MariBank QR.jpg') }}" alt="MariBank QR Code" class="payment-qr"><span>View QR code</span></a></article><article class="payment-method-card"><div class="payment-method-top"><div class="payment-method-icon cash-icon">₱</div><div><h3>Cash</h3><span class="payment-method-subtitle">In-person payment</span></div></div><div class="cash-payment-box"><span>Payment Location</span><strong>026 Pulantubig,<br>Dumaguete City,<br>Negros Oriental,<br>Philippines</strong></div></article></div><div class="payment-reminder">After sending your payment, submit the details below. Your balance updates after admin confirmation.</div></section>
	<section class="dashboard-cards"><article class="dashboard-card"><h2>Submit Payment</h2>{% if loans is empty %}<p class="card-empty">You do not have an active approved loan.</p>{% else %}{{ form_start(form, {attr: {class: 'payment-submit-form'}}) }}{{ form_errors(form) }}<div class="form-group">{{ form_label(form.loan_id, 'Loan') }}{{ form_widget(form.loan_id) }}{{ form_errors(form.loan_id) }}</div><div class="form-group">{{ form_label(form.payment_date, 'Payment Date') }}{{ form_widget(form.payment_date, {attr: {max: 'today'|date('Y-m-d')}}) }}{{ form_errors(form.payment_date) }}</div><div class="form-group">{{ form_label(form.amount_paid, 'Amount Paid (₱)') }}{{ form_widget(form.amount_paid, {attr: {min: '0.01', step: '0.01'}}) }}{{ form_errors(form.amount_paid) }}</div><div class="form-group">{{ form_label(form.payment_method, 'Payment Method') }}{{ form_widget(form.payment_method) }}{{ form_errors(form.payment_method) }}</div><div class="form-group">{{ form_label(form.reference_number, 'Reference Number') }}{{ form_widget(form.reference_number, {attr: {maxlength: 100, placeholder: 'e.g. GCash transaction ID'}}) }}</div>{{ form_widget(form.submit, {attr: {class: 'welcome-cta'}}) }}{{ form_end(form) }}{% endif %}</article>
	<article class="dashboard-card"><h2>Payment History</h2>{% if payments is empty %}<p class="card-empty">No payments yet.</p>{% else %}<ul class="activity-list">{% for payment in payments %}<li><span>₱{{ payment.amountPaid|number_format(2) }}<small>Loan #{{ payment.loanApplication.id }} · {{ payment.paymentDate|date('M j, Y') }}</small></span><span class="status-badge {{ payment.status == 'confirmed' ? 'status-approved' : (payment.status == 'failed' ? 'status-rejected' : 'status-pending') }}">{{ payment.status|title }}</span></li>{% endfor %}</ul>{% endif %}</article></section>
</main>{% endblock %}