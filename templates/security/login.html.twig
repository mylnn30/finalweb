{% extends 'base.html.twig' %}
{% block title %}Sign In | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/login.css') }}">{% endblock %}
{% block body %}
<main class="login-page"><section class="login-container">
    <header class="login-header"><h1>Welcome Back</h1><p>Sign in to your Mletchido Financial Group account</p></header>
    {% if error %}<div class="form-error" role="alert" aria-live="polite"><p>{{ error.messageKey|trans(error.messageData, 'security') }}</p></div>{% endif %}
    <form action="{{ path('app_login') }}" method="POST" class="login-form" novalidate>
        <div class="form-group"><label for="username">Username</label><input type="text" id="username" name="_username" value="{{ lastUsername }}" autocomplete="username" autofocus required></div>
        <div class="form-group"><label for="password">Password</label><input type="password" id="password" name="_password" autocomplete="current-password" required></div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <label class="remember-option"><input type="checkbox" name="_remember_me"> Remember me</label>
        <button type="submit" class="login-button">Sign In</button>
        <p class="register-link">Don't have an account? <a href="{{ path('app_register') }}">Create Account</a></p>
    </form>
</section></main>
{% endblock %}