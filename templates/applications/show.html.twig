{% extends 'base.html.twig' %}
{% block title %}Application Details | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}"><link rel="stylesheet" href="{{ asset('css/applications.css') }}">{% endblock %}
{% block body %}{% include 'partials/borrower_nav.html.twig' with {active: 'applications'} %}<main class="applications-page"><section class="applications-container"><a href="{{ path('app_applications') }}" class="back-link">← Back to My Applications</a><header class="applications-header"><h1>{{ application.loanType|replace({'_':' '})|title }}</h1><span class="status-badge status-{{ application.status }}">{{ application.status|title }}</span></header><div class="detail-grid"><div class="detail-field"><span class="field-label">Loan Amount</span><span class="field-value">₱{{ application.amount|number_format(2) }}</span></div><div class="detail-field"><span class="field-label">Repayment Term</span><span class="field-value">{{ application.termMonths }} Months</span></div><div class="detail-field"><span class="field-label">ID Type</span><span class="field-value">{{ application.idType|replace({'_':' '})|title }}</span></div><div class="detail-field"><span class="field-label">Employment Status</span><span class="field-value">{{ application.employmentStatus|replace({'_':' '})|title }}</span></div><div class="detail-field"><span class="field-label">Occupation / Job Title</span><span class="field-value">{{ application.occupation }}</span></div>{% if application.employmentStatus == 'employed' %}<div class="detail-field"><span class="field-label">Employer / Company Name</span><span class="field-value">{{ application.employerName }}</span></div><div class="detail-field"><span class="field-label">Length of Employment</span><span class="field-value">{{ application.lengthOfEmployment|replace({'_':' '})|title }}</span></div><div class="detail-field"><span class="field-label">Employer Contact Number</span><span class="field-value">{{ application.employerContactNumber }}</span></div>{% elseif application.employmentStatus == 'self_employed' %}<div class="detail-field"><span class="field-label">Business Name</span><span class="field-value">{{ application.businessName }}</span></div><div class="detail-field"><span class="field-label">Business Type</span><span class="field-value">{{ application.businessType|replace({'_':' '})|title }}</span></div>{% endif %}<div class="detail-field"><span class="field-label">Monthly Income</span><span class="field-value">₱{{ application.monthlyIncome|number_format(2) }}</span></div><div class="detail-field"><span class="field-label">Preferred Payment Frequency</span><span class="field-value">{{ application.paymentFrequency|title }}</span></div><div class="detail-field"><span class="field-label">Date Submitted</span><span class="field-value">{{ application.submittedAt|date('F j, Y g:i A') }}</span></div><div class="detail-field detail-field-full"><span class="field-label">Purpose</span><span class="field-value">{{ application.purpose|nl2br }}</span></div><div class="detail-field"><span class="field-label">Valid ID</span><a href="{{ path('app_document', {filename: application.validIdPath}) }}"><img src="{{ path('app_document', {filename: application.validIdPath}) }}" alt="Uploaded Valid ID" class="document-thumb"></a></div><div class="detail-field"><span class="field-label">Proof of Income</span><a href="{{ path('app_document', {filename: application.proofOfIncomePath}) }}"><img src="{{ path('app_document', {filename: application.proofOfIncomePath}) }}" alt="Uploaded Proof of Income" class="document-thumb"></a></div><div class="detail-field"><span class="field-label">Proof of Address</span><a href="{{ path('app_document', {filename: application.proofOfAddressPath}) }}"><img src="{{ path('app_document', {filename: application.proofOfAddressPath}) }}" alt="Uploaded Proof of Address" class="document-thumb"></a></div>{% if application.employmentCertificatePath %}<div class="detail-field"><span class="field-label">Employment Certificate</span><a href="{{ path('app_document', {filename: application.employmentCertificatePath}) }}"><img src="{{ path('app_document', {filename: application.employmentCertificatePath}) }}" alt="Uploaded Employment Certificate" class="document-thumb"></a></div>{% endif %}</div></section></main>{% endblock %}