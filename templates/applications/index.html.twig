{% extends 'base.html.twig' %}
{% block title %}My Applications | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}"><link rel="stylesheet" href="{{ asset('css/applications.css') }}">{% endblock %}
{% block body %}{% include 'partials/borrower_nav.html.twig' with {active: 'applications'} %}<main class="applications-page"><section class="applications-container"><header class="applications-header"><h1>My Applications</h1><a href="{{ path('app_loan_new') }}" class="applications-apply-btn">Apply for a Loan</a></header>{% if applications is empty %}<div class="applications-empty"><p>You haven't submitted any loan applications yet.</p><a href="{{ path('app_loan_new') }}" class="applications-apply-btn">Apply Now</a></div>{% else %}<div class="applications-table"><div class="applications-row applications-row-head"><span>Loan Type</span><span>Amount</span><span>Term</span><span>Status</span><span>Submitted</span><span></span></div>{% for application in applications %}<div class="applications-row"><span data-label="Loan Type">{{ application.loanType|replace({'_':' '})|title }}</span><span data-label="Amount">₱{{ application.amount|number_format(2) }}</span><span data-label="Term">{{ application.termMonths }} mo</span><span data-label="Status"><span class="status-badge status-{{ application.status }}">{{ application.status|title }}</span></span><span data-label="Submitted">{{ application.submittedAt|date('M j, Y') }}</span><span><a href="{{ path('app_application_show', {id: application.id}) }}" class="applications-view-link">View →</a></span></div>{% endfor %}</div>{% endif %}</section></main>{% endblock %}