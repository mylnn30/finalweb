{% extends 'base.html.twig' %}
{% block title %}Dashboard | Mletchido Financial Group{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/dashboard.css') }}">{% endblock %}
{% block body %}
{% include 'partials/borrower_nav.html.twig' with {active: 'dashboard', unreadCount: unreadCount} %}
<main class="dashboard-page">
    <section class="dashboard-welcome"><div><h1>Welcome back, {{ app.user.firstName ?: app.user.username }}</h1><p>Here's what's happening with your account today.</p></div><a href="{{ path('app_loan_new') }}" class="welcome-cta">Apply for a Loan</a></section>
    <section class="stat-row"><div class="stat-tile"><span class="stat-value">{{ applications|length }}</span><span class="stat-label">Recent Applications</span></div><div class="stat-tile"><span class="stat-value">{{ activeLoans|length }}</span><span class="stat-label">Approved Loans</span></div><div class="stat-tile"><span class="stat-value">₱{{ remaining|number_format(2) }}</span><span class="stat-label">Remaining Balance</span></div></section>
    {% if unreadNotifications %}<section class="dashboard-card notification-card"><h2>Unread Notifications</h2><ul class="activity-list">{% for notification in unreadNotifications|slice(0, 3) %}<li><span>{{ notification.message }}</span></li>{% endfor %}</ul><a href="{{ path('app_notifications') }}" class="card-link">View All Notifications →</a></section>{% endif %}
    {% if activeLoans %}<section class="payments-section"><div class="payments-header"><div><span class="payments-eyebrow">LOAN REPAYMENT</span><h2>My Active Loans</h2><p>Track your balance, repayment progress, and upcoming payments.</p></div></div>
        {% for loan in activeLoans %}{% set totalPayable = finance.totalPayable(loan) %}{% set balance = finance.remainingBalance(loan) %}{% set totalPaid = max(0, totalPayable - balance) %}{% set progress = totalPayable > 0 ? min(100, max(0, totalPaid / totalPayable * 100)) : 0 %}<article class="loan-payment-card"><div class="loan-payment-top"><div><span class="loan-type">{{ loan.loanType|replace({'_':' '})|upper }}</span><h3>Loan #{{ loan.id }}</h3></div><span class="loan-status {{ finance.isOverdue(loan) ? 'overdue' : 'active' }}"><span class="status-dot"></span>{{ finance.isOverdue(loan) ? 'Overdue' : 'Active' }}</span></div><div class="loan-balance"><span>Remaining Balance</span><strong>₱{{ balance|number_format(2) }}</strong></div><div class="payment-progress"><div class="progress-info"><span>Repayment Progress</span><strong>{{ progress|number_format(0) }}%</strong></div><div class="progress-track"><div class="progress-fill" style="width: {{ progress }}%;"></div></div><div class="progress-amounts"><span>₱{{ totalPaid|number_format(2) }} paid</span><span>₱{{ totalPayable|number_format(2) }} total</span></div></div><div class="loan-details"><div class="loan-detail"><span class="detail-label">Loan Amount</span><strong>₱{{ loan.amount|number_format(2) }}</strong></div><div class="loan-detail"><span class="detail-label">Interest</span><strong>{{ (loan.interestRate ?? '0')|number_format(2) }}%</strong></div><div class="loan-detail"><span class="detail-label">Installment</span><strong>₱{{ finance.installmentAmount(loan)|number_format(2) }}</strong><small>{{ loan.paymentFrequency|title }}</small></div><div class="loan-detail"><span class="detail-label">Next Due</span><strong>{{ loan.nextDueDate ? loan.nextDueDate|date('M j, Y') : 'Not set' }}</strong>{% if finance.isOverdue(loan) %}<small class="overdue-text">Payment overdue</small>{% endif %}</div></div><div class="loan-payment-footer"><span>Total payable: <strong>₱{{ totalPayable|number_format(2) }}</strong></span><a href="{{ path('app_payments') }}" class="payment-action">Make a Payment <span>→</span></a></div></article>{% endfor %}
    </section>{% endif %}
    <section class="dashboard-cards"><article class="dashboard-card"><div class="card-icon">◒</div><h2>Account</h2><p><strong>Username:</strong> {{ app.user.username }}</p><p><strong>Name:</strong> {{ app.user.firstName }} {{ app.user.lastName }}</p><p><strong>Email:</strong> {{ app.user.email }}</p><a href="{{ path('app_profile') }}" class="card-link">View Profile →</a></article><article class="dashboard-card"><div class="card-icon">▤</div><h2>Loan Applications</h2>{% if applications %}<ul class="activity-list">{% for application in applications %}<li><span><a href="{{ path('app_application_show', {id: application.id}) }}">{{ application.loanType|replace({'_':' '})|title }}</a></span><span class="status-badge status-{{ application.status }}">{{ application.status|title }}</span></li>{% endfor %}</ul>{% else %}<p class="card-empty">You haven't submitted any applications yet.</p>{% endif %}<a href="{{ path('app_applications') }}" class="card-link">View Applications →</a></article><article class="dashboard-card dashboard-card-highlight"><div class="card-icon">✦</div><h2>Apply for a Loan</h2><p>Ready to take the next step? Start a new loan application in minutes.</p><a href="{{ path('app_loan_new') }}" class="card-link">Apply Now →</a></article></section>
</main>
{% endblock %}